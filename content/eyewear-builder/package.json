{
  "name": "eyewear-builder",
  "private": true,
  "version": "1.0.0",
  "description": "A browser eyewear configurator: design a frame from real shape keys, then try it on with webcam face tracking.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-wasm.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "sync:wasm": "node scripts/sync-wasm.mjs",
    "deploy": "npm run build && node deploy.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  }
}
